FROM fedora:42 AS base

# Install build dependencies
RUN dnf install -y \
  bash git curl gcc gcc-c++ clang ninja-build cmake \
  openssl-devel clang-devel protobuf-devel \
  libX11-devel libXcursor-devel libXrandr-devel \
  libXinerama-devel libXi-devel dbus-devel \
  && dnf clean all

# Setup Rust
ENV RUSTUP_HOME=/usr/local/rustup \
  CARGO_HOME=/usr/local/cargo \
  PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
  && rustup default nightly

# Build argument for cache invalidation
ARG GIT_COMMIT=unknown
LABEL git_commit=${GIT_COMMIT}

# Cache buster - this will invalidate cache when commit changes
RUN echo "Building with commit: ${GIT_COMMIT}"

# Copy local repository sources (excluding build artifacts via .dockerignore)
COPY . /shards
WORKDIR /shards

# Build Shards
RUN sh update.sh \
  && ./bootstrap \
  && mkdir -p build \
  && cd build \
  && cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
  -DRUST_BUILD_TYPE=Small \
  -DSHARDS_WITH_EVERYTHING=OFF \
  -DSHARDS_WITH_LANGFFI=ON \
  -DSHARDS_WITH_ASSERT=ON \
  -DSHARDS_WITH_BROTLI=ON \
  -DSHARDS_WITH_CHANNELS=ON \
  -DSHARDS_WITH_CORE=ON \
  -DSHARDS_WITH_CRYPTO=ON \
  -DSHARDS_WITH_DEBUG=ON \
  -DSHARDS_WITH_FS=ON \
  -DSHARDS_WITH_HTTP=ON \
  -DSHARDS_WITH_JSON=ON \
  -DSHARDS_WITH_NETWORK=ON \
  -DSHARDS_WITH_OS=ON \
  -DSHARDS_WITH_RANDOM=ON \
  -DSHARDS_WITH_SNAPPY=ON \
  -DSHARDS_WITH_SQLITE=ON \
  -DSHARDS_WITH_TRACY=ON \
  -DSHARDS_WITH_MARKDOWN=ON \
  -DSHARDS_WITH_STRUCT=ON \
  -DSHARDS_WITH_REFLECTION=ON \
  -DSHARDS_WITH_BIGINT=ON \
  -DSHARDS_WITH_CSV=ON \
  -DSHARDS_WITH_RUN=ON \
  .. \
  && ninja -j$(nproc) shards

# Runtime stage
FROM fedora:42
RUN dnf install -y bash curl ca-certificates sqlite && dnf clean all
COPY --from=base /shards/build/shards /usr/local/bin/shards
WORKDIR /app
ENTRYPOINT ["shards"]
