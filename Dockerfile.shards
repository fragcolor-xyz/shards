FROM fedora:42 AS base

# Install all dependencies
RUN dnf install -y \
  bash git curl gcc gcc-c++ clang ninja-build cmake \
  openssl-devel clang-devel protobuf-devel \
  libX11-devel libXcursor-devel libXrandr-devel \
  libXinerama-devel libXi-devel dbus-devel \
  python3 python3-pip \
  && dnf clean all

# Setup Rust
ENV RUSTUP_HOME=/usr/local/rustup \
  CARGO_HOME=/usr/local/cargo \
  PATH=/usr/local/cargo/bin:$PATH

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
  && rustup default nightly

# Build argument for cache invalidation
ARG GIT_COMMIT=unknown
ARG TARGETARCH
LABEL git_commit=${GIT_COMMIT}

# Cache buster - this will invalidate cache when commit changes
RUN echo "Building with commit: ${GIT_COMMIT} for architecture: ${TARGETARCH}"

# Copy local repository sources (excluding build artifacts via .dockerignore)
COPY . /shards
WORKDIR /shards

RUN sh update.sh \
  && ./bootstrap \
  && mkdir -p build

# Build Shards
RUN --mount=type=cache,id=cargo-registry-${TARGETARCH},target=/root/.cargo/registry \
  --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
  --mount=type=cache,id=shards-build-shards-${TARGETARCH},target=/shards/build \
  cd build \
  && cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
  -DRUST_BUILD_TYPE=Small \
  .. \
  && ninja -j$(nproc) shards \
  && cp shards /shards/shards

# Runtime stage
FROM fedora:42
RUN dnf install -y \
  bash curl ca-certificates sqlite python3 \
  libX11 libXcursor libXrandr libXinerama libXi dbus-libs \
  && dnf clean all
COPY --from=base /shards/shards /usr/local/bin/shards
WORKDIR /app
ENTRYPOINT ["shards"]
