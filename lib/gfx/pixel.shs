// Aligns a viewport to the either top-left or bottom-right based on alignment
// use with GFX.View(View: <output from this> OrthographicSizeType: OrthographicSizeType::PixelScale)
@template(gfx/align-pixel-viewport [alignment] {
  GFX.Viewport | Memoize({
    = vp
    vp:2 | Sub((vp:0)) | ToFloat = width
    vp:3 | Sub((vp:1)) | ToFloat = height
    
    alignment | Sub(0.5) = v
    
    // Align viewport based on alignment parameter [0,1]
    @f2(width height) | Mul(v) >= view-offset
    view-offset | ToFloat3 | Add(@f3(0 0 0.0)) | Math.Translation
  })
})