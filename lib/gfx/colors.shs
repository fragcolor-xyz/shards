; H/S/L are all [0,1]
@template(gfx/hsl-to-rgb [hue saturation lightness] {
  ; Chroma = (1 - |2L-1|) * S
  1.0 | Sub((lightness | Mul(2.0) | Sub(1.0) | Math.Abs)) | Mul(saturation) = chroma
  
  ; Hue' = Hue * 6
  hue | Mul(6.0) = h-prime
  
  ; X = C * (1 - |H' mod 2 - 1|)
  1.0 | Sub((h-prime | Math.Mod(2.0) | Sub(1.0) | Math.Abs)) | Mul(chroma) = x
  
  ; m = L - C/2
  lightness | Sub((chroma | Div(2.0))) = m
  
  ; RGB' based on H'
  h-prime | ToInt | Match([
    0 {@f3(chroma x 0.0)}
    1 {@f3(x chroma 0.0)}
    2 {@f3(0.0 chroma x)}
    3 {@f3(0.0 x chroma)}
    4 {@f3(x 0.0 chroma)}
    5 {@f3(chroma 0.0 x)}
    6 {@f3(chroma x 0.0)}
  ] Passthrough: false) | Math.Add(m) | Mul(255.0) | Math.Round
  ; Output is bytes/int [0,255]
  ToColor
})

; https://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
@template(gfx/srgb-to-linear3 [in] {
  in = c
  c | Mul(c) = c-sqr
  c-sqr | Mul(c) = c-cube
  
  c | Mul(0.012522878)
  Math.Add((c-sqr | Mul(0.682171111)))
  Math.Add((c-cube | Mul(0.305306011)))
})

@template(gfx/float4-with-alpha [alpha] {
  {@f4(0.0 0.0 0.0 alpha) = f4-a}
  ToFloat3 | ToFloat4 | Math.Add(f4-a)
})

; Convert sRGB color to linear Float4
@template(gfx/color-to-float4 [color] {
  color | ToFloat4 | Div(255.0)
  {Take(3) = a
    @f4(0.0 0.0 0.0 a) = f4-a
  }
  ToFloat3 = c
  @gfx/srgb-to-linear3(c) | ToFloat4 | Math.Add(f4-a)
})

@template(gfx/color-to-float4-with-alpha [color alpha] {
  color | ToFloat3 | Div(255.0) = c3
  @gfx/srgb-to-linear3(c3) | ToFloat4 | Add(@f4(0.0 0.0 0.0 alpha))
})
