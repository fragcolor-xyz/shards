@define(script-hot-reload false IgnoreRedefined: true)

; Builds wrapper wires around imported hot-reloadable wires
; usage:
;   @hot-reload(@script-dir @namespace "my-script.shs" [wire-0 wire-1 ...])
; The wires can then be invoked simply using Do(wire-0), etc.
@macro(hot-reload [base-path include-dirs namespace script-path wires] {
  Sequence(hr-root-seq)
  
  ["hlw-" (script-path | FS.Filename(true))] | String.Format = wrapper-name
  {id: {name: wrapper-name}} | ToJson = wrapper-name-id-json
  
  ; Escape \ in base-path
  [base-path script-path] | FS.Join = script-path-abs
  script-path-abs | Regex.Replace("\\\\" "\\\\\\\\") = script-path-escaped
  
  [script-path-abs namespace] | Log("Setting up hot reload for script")
  
  [
    "\"seq\":["
    (include-dirs | Map({
        ["{\"str\":\"" $0 "\"}"] | String.Format
      }) | String.Join(",") | Regex.Replace("""\\""" """\\""")
    )
    "]"
  ] | String.Format = include-dirs-json
  
  ; Body of the loader wire
  @ast(
    @wire(loader {
      @wire(dummy-wire {
        Pass
      })
      
      Once({
        Table(hot-result Type: @type({tag: Type::Int none: Type::Wire}))
        Sequence(dependencies Type: @type([Type::String]))
        {tag: 0} > hot-result
      })
      
      Maybe({
        dependencies | Map({FS.LastWriteTime}) >= sub-lwt
        script-path | FS.LastWriteTime | PrependTo(sub-lwt)
        sub-lwt
      } {[0]}) = timestamps
      
      timestamps | Memoize({
        [script-path timestamps] | Log("Triggered change on script" Level: LogLevel::Debug)
        Maybe({
            script-path | FS.Read | Shards.Read(
              BasePath: (script-path | FS.Parent)
              Include: include-dirs
              OutputType: AstType::AdvancedObject
            )
            {Take("dependencies") | Log("Script dependencies" Level: LogLevel::Trace) > dependencies}
            Take("ast")
            Shards.Distill(
              Context: @capture-eval-context
              Name: #(script-path | FS.Filename(true))
              Namespace: namespace
            ) = wire
            
            hot-result:tag = old-tag
            {tag: (old-tag | Add(1))} > hot-result
            WireRunner(wire) | ExpectTable
            ForEach({
              $1 | ExpectWire | Update(hot-result $0)
            })
          } {
            Msg((["Failed to distill " script-path] | String.Format) Level: LogLevel::Error Name: "reload")
            
            ; wire-names | ForEach({
            ;   dummy-wire | Update(hot-result $0)
            ; })
          }
        )
      })
      
      hot-result
    } Pure: true)
  ) = loader-ast
  Regex.Replace("""\{"id":\{"name":"loader"\}\}""" wrapper-name-id-json)
  Regex.Replace("""\{"id":\{"name":"namespace"\}\}""" (["{\"str\": \"" namespace "\"}"] | String.Format))
  Regex.Replace("""\{"id":\{"name":"script-path"\}\}""" (["{\"str\": \"" script-path-escaped "\"}"] | String.Format))
  Regex.Replace(""""id":\{"name":"include-dirs"\}""" include-dirs-json)
  
  FromJson = loader-ast-1
  [loader-ast-1] >> hr-root-seq
  
  ; Body of the wrapper wire
  NanoID >= rnd
  @ast({
    Once({
      false >= _we
    })
    {
      ; #([wire-name (TypeOf({Do(wrapper-id)}))] | Log("Wrapper ID type"))
      none | Do(wrapper-id) = _wt
    }
    
    Get(_wt "tag") | Memoize({
      Msg((["Reloaded wire " wire-name] | String.Format) Level: LogLevel::Info Name: "reload")
      false > _we
    })
    WhenNot({_we} {
      Maybe({
          WireRunner((Get(_wt wire-name)))
        } {
          Msg((["Failed to run wire " wire-name] | String.Format) Level: LogLevel::Error Name: "reload")
          true > _we
        }
      )
    })
  })
  Regex.Replace("""\{"id":\{"name":"wrapper-id"\}\}""" wrapper-name-id-json)
  Regex.Replace("""_we""" (["_we" rnd] | String.Format))
  Regex.Replace("""_wt""" (["_wt" rnd] | String.Format))
  = body-shards-1
  
  @ast(wires) | FromJson | ExpectTable
  Take("seq") | ExpectSeq
  ForEach({
    ExpectTable = fn-id
    Log("Generating wrapper function")
    Take("id") | ExpectTable = wire-id
    Take("name") = wire-name
    @ast(
      @wire(wire-name {
        Pass
      })
    ) | FromJson | Expect(@type({func: {params: [{none: Type::Any}]}})) >= wire-ast
    Take("func") >= func
    Take("params") >= params
    [0 fn-id] | Assoc(params)
    
    body-shards-1 | Regex.Replace("""\{"id":\{"name":"wire-name"\}\}""" (["{\"str\": \"" wire-name "\"}"] | String.Format)) | FromJson = body-shards2
    [1 body-shards2] | Assoc(params)
    
    params | Update(func "params")
    func | Update(wire-ast "func")
    
    [wire-ast]
    >> hr-root-seq
  })
  
  hr-root-seq | ToJson
})

@inline-template(maybe-hot-reload [script-path wires] {
  @if(@script-hot-reload {
      @hot-reload(@script-dir @include-dirs @namespace script-path wires)
    } {
      @include(script-path)
    }
  )
})
