@define(text-model "/Users/sugar/Downloads/gemma-3-4b-it-q4_0.gguf" IgnoreRedefined: true)

@text-model | LLM.Model(UseMmap: false GPULayers: 1000) = model
LLM.Chat = chat-context

LLM.AddBos

"I must not fear. Fear is the mind-killer. Fear is the little-death that brings total obliteration. I will face my fear. I will permit it to pass over me and through me. And when"
LLM.AddText(chat-context NeedLogits: true)

Sequence(tokens Type: @type([Type::String]))
Repeat({
  chat-context | LLM.Generate(Temperature: 0.5) | Log("Generated token")
  If(Is("") Return Pass) >> tokens
} Times: 512)

tokens | String.Join | String.Trim | Log("Response")