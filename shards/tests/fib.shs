; Not the best subject for shards at all
; but still if competitive in this would be nice

@mesh(root)

@wire(fib4 {
  Math.Subtract(3) = n
  1 >= a
  2 >= b
  Repeat({
    a | Math.Add(b) = c
    b > a
    c > b
  } Times: n)
  b
})

; we use this to test stack overflow protection
@wire(run {
  Profile({35000 | Do(fib1)})
  Log("result")
})

@schedule(root run)
@run(root) | Assert.Is(false)
