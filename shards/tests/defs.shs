@macro(tmp-path [path] {
  Sequence(pipelines)
  @platform | If(Is("emscripten") {
      {
        eExpr: [[
            {const: {seq: [{str: "/tmp"} {str: path}]}}
            {sh: {name: "FS.Join"}}]]
      } >> pipelines
    } {
      {const: {str: path}} >> pipelines
    }
  )
  
  [pipelines] | ToJson
})
