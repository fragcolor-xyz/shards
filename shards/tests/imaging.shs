@include("defs.shs")

LoadImage("../../assets/simple1.PNG") >= baseImg
StripAlpha
WritePNG(@tmp-path("testbase.png"))
Ref(img)
Repeat({
  Get(img)
  Convolve(50)
  WritePNG(@tmp-path("test.png"))
  Log
  ImageToFloats
  Ref(s)
  Count(s)
  Log
  Get(s)
  FloatsToImage(99 99 3)
  WritePNG(@tmp-path("test2.png"))
  FillAlpha
  ResizeImage(200 200)
  WritePNG(@tmp-path("test2Resized.png"))
} Times: 30)
Log
baseImg
ResizeImage(Width: 200 Height: 0)
WritePNG(@tmp-path("testResized1.png"))
baseImg
ResizeImage(Width: 0 Height: 200)
WritePNG(@tmp-path("testResized2.png"))
StripAlpha
WriteJPG(@tmp-path("testResized2.jpg"))
{WritePNG | ExpectBytes
  LoadImage | ImageToBytes | ExpectBytes
}
{WriteJPG | ExpectBytes
  LoadImage | ImageToBytes | ExpectBytes
}

"../../assets/Freesample.svg"
FS.Read(Bytes: true)
SVG.ToImage
WritePNG(@tmp-path("svgtest.png"))
