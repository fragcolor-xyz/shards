@define(placement-type #(TypeOf({[] | ToBytes | GFX.FontMap = f | "" | GFX.TextPlacement(f) | Take(0)})))
@include("../../lib/gfx/pixel.shs")

@wire(test-wire {
  Once({
    ; Create render steps
    GFX.BuiltinFeature(BuiltinFeatureId::Transform) >> features
    GFX.BuiltinFeature(BuiltinFeatureId::BaseColor) >> features
    GFX.BuiltinFeature(BuiltinFeatureId::AlphaBlend) >> features
    GFX.Feature(State: {FlipFrontFace: false DepthWrite: false}) >> features
    GFX.DrawQueue = queue
    GFX.DrawablePass(Features: features Queue: queue) >> render-steps
    
    GFX.DrawQueue = ui-draw-queue
    GFX.UIPass(ui-draw-queue) >> render-steps
    
    32 >= font-size
    Table(tile-map Type: @type({none: @placement-type}))
    
    0 >= refresh-trigger
    
    -0.5 >= valign
    0.5 >= halign
    
    ; List fonts in the data/fonts directory
    "data/fonts" | FS.Iterate(Recursive: true) >= raw-fonts
    Remove(From: raw-fonts Predicate: {
      FS.IsFile | Not | Or
      FS.Extension | IsNot(".ttf")
    }) | Map({FS.RelativeTo("data/fonts")}) = font-list
    font-list | IndexOf(Predicate: {
      Is("_robotto\\Roboto-Regular.ttf")
    }) | Max(0) = font-index
    
    "☺☻♥♦♣♠•◘○◙♂♀♪♫☼►◄↕‼¶§▬↨↑↓→←∟↔▲▼!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~⌂ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜ¢£¥₧ƒáíóúñÑªº¿⌐¬½¼¡«»░▒▓│┤╡╢╖╕╣║╗╝╜╛┐└┴┬├─┼╞╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌█▄▌▐▀αßΓπΣσµτΦΘΩδ∞φε∩≡±≥≤⌠⌡÷≈°∙·√ⁿ²■"
    String.CodePoints = char-set
  })
  
  [font-size font-index] | Memoize({
    font-list | Take(font-index) = selected-font
    Log("Selected font")
    ["data/fonts/" selected-font] | String.Format | FS.Read(Bytes: true) = font-data
    font-size | Log("Font size")
    font-data | GFX.FontMap = font
    GFX.FontSpaceSize(font-size) = space-size
    Log("Font spacing")
    {Take(0) = space-size-x}
    {Take(1) = space-size-y}
    @f3((space-size-x | ToFloat) (space-size-y | ToFloat) 0.0) = space-size-f3
    
    Math.Inc(refresh-trigger)
  })
  
  Clear(tile-map)
  
  GFX.MainWindow(Title: "Text Demo" Width: 1280 Height: 720 Contents: {
    GFX.Viewport = vp
    [font-index vp font-size] | Memoize({
      vp:2 | Sub((vp:0)) | ToFloat = width
      vp:3 | Sub((vp:1)) | ToFloat = height
      
      Math.Inc(refresh-trigger)
    })
    
    GFX.View(View: (@gfx/align-pixel-viewport(@f2(0.0))) OrthographicSize: @f2(1.0 -1.0) OrthographicSizeType: OrthographicSizeType::PixelScale) = view
    
    ; UI for font selection and size
    UI({
      UI.Window(Contents: {
        "Font:" | UI.Label
        font-list | UI.Combo(Label: "Select Font" Index: font-index)
        "Font Size:" | UI.Label
        UI.IntSlider(Variable: font-size Min: 8 Max: 72)
        "Vertical Align:" | UI.Label
        UI.FloatSlider(Variable: valign Min: -1.0 Max: 1.0)
        "Horizontal Align:" | UI.Label
        UI.FloatSlider(Variable: halign Min: 0.0 Max: 1.0)
      } Position: @f2(100 300))
    }) | UI.Render(ui-draw-queue)
    
    64.0 >= base-x
    64.0 >= base-y
    64.0 | Add(300.0) >= base-x-2
    64.0 | Add((space-size-y | ToFloat)) >= base-y-2
    
    ; Draw avocado for reference on orhographic output
    Gizmos.Context(Queue: queue View: view
      Contents: {
        Gizmos.Line(@f3(base-x base-y 0.0) @f3(width base-y 1.0) Color: @f4(1.0 1.0 1.0 0.5))
        Gizmos.Line(@f3(base-x-2 base-y-2 0.0) @f3(width base-y-2 1.0) Color: @f4(0.5 0.5 1.0 0.5))
      }
    )
    
    GFX.DynMesh = dmesh
    "Hello world!" | GFX.DynDrawText(Output: dmesh Font: font FontSize: font-size Offset: @f3(base-x base-y 0.0) VAlign: valign)
    "Hello world! (w. HAlign)" | GFX.DynDrawText(Output: dmesh Font: font FontSize: font-size Offset: @f3(base-x-2 base-y-2 0.0) VAlign: valign HAlign: halign)
    
    ; Draw the generated mesh
    dmesh | GFX.DynToMesh | DoMany({
      {Take("mesh") = mesh}
      {Take("texture") = texture}
      Math.MatIdentity | GFX.Drawable(mesh Params: {baseColorTexture: texture}) | GFX.Draw(queue)
    } ComposeSync: true)
    GFX.Render(Steps: render-steps View: view)
  })
} Looped: true)

@mesh(root)
@schedule(root test-wire)
@run(root FPS: 60 Iterations: 100) | Assert.Is(true)
