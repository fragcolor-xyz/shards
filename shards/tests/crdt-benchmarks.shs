CRDT.New(@i16(77) Preallocate: 1000000) = crdt
@define(crdt-key "ThisIsAKey")

Sequence(records Type: @type([Type::Int16]))

// insert 1000000 records
Msg("Inserting 1000000 records")
Profile(Repeat({
  UUID = record >> records 
  RandomFloat | CRDT.Set(CRDT: crdt Record: record Keys: @crdt-key)
} Times: 1000000))

Msg("Reading 1000000 records")
Profile({
  records | ForEach({
    CRDT.Get(CRDT: crdt Keys: [@crdt-key])
  })
})

Msg("Deleting 1000000 records")
Profile({
  records | ForEach({
    CRDT.Delete(CRDT: crdt)
  })
})

Clear(records)

// insert again 1000000 records
Msg("Inserting 1000000 records again")
Profile(Repeat({
  UUID >> records = record
  RandomFloat | CRDT.Set(CRDT: crdt Record: record Keys: @crdt-key)
} Times: 1000000))

Msg("Reading 1000000 records again")
Profile({
  records | ForEach({
    CRDT.Get(CRDT: crdt Keys: [@crdt-key])
  })
})
