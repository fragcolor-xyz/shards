@wire(tail-call-restart {
  Once(Set(value)) // set it only once!
  Inc(value)
  value | If(IsMore(10) {
      Msg("More than 10")
      value
    } {
      Msg("Less than 10")
      value | Restart
    }
  )
})

1 | Do(tail-call-restart) | Log

