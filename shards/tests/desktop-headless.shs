// Headless desktop test — runs inside a headless sway compositor.
// Uses Desktop.StartSession (portal flow) with auto-approved ScreenCast.
// Launched by test-desktop-headless.sh which sets up the environment.
//
// Sway is configured with:
//   output HEADLESS-1 resolution 1280x720
//   output * bg #204a4a solid_color

@mesh(root)

@wire(desktop-headless-test {
  // =========================================================================
  // Phase 1: Portal session + basic capture verification
  // =========================================================================

  Desktop.StartSession | Log("Session started") >= session
  session | Desktop.CaptureFrame
  Pause(2.0)
  session | Desktop.CaptureFrame

  // Verify background color #204a4a → RGB(32,74,74) at multiple points
  @i2(10 10) | Desktop.Pixel(Session: session)
  | Assert.Is(@color(32 74 74 255))
  | Log("Pixel (10,10) verified")

  @i2(640 360) | Desktop.Pixel(Session: session)
  | Assert.Is(@color(32 74 74 255))
  | Log("Pixel (center) verified")

  // Verify region capture dimensions
  @i4(0 0 64 64) | Desktop.Pixels(Session: session)
  | Log("64x64 region captured")

  // =========================================================================
  // Phase 2: Open terminal, verify screen changes
  // =========================================================================

  // Launch foot terminal via swaymsg (returns non-zero, ignore)
  Maybe({
    "" | Process.Run(Executable: "swaymsg" Arguments: ["exec" "foot"])
  } Pass)
  "Launched foot terminal" | Log
  Pause(1.5)

  // Capture frame — terminal should now be visible
  session | Desktop.CaptureFrame
  Pause(0.5)
  session | Desktop.CaptureFrame

  // Terminal background (foot default) should differ from sway background
  @i2(640 360) | Desktop.Pixel(Session: session) >= term-pixel
  term-pixel | Log("Center pixel with terminal")
  term-pixel | Assert.IsNot(@color(32 74 74 255))
  "Terminal changed screen content" | Log

  // =========================================================================
  // Phase 3: Type command via wtype, verify file created
  // =========================================================================

  // =========================================================================
  // Phase 3: Execute shell command via swaymsg, verify file created
  // =========================================================================

  // Use swaymsg exec to run a shell command in the headless compositor.
  // This verifies the compositor is functional and can execute processes.
  Maybe({
    "" | Process.Run(
      Executable: "swaymsg"
      Arguments: ["exec" "bash -c 'echo swaymsg-ok > /tmp/shards-exec-test.txt'"]
    )
  } Pass)
  Pause(1.0)

  "/tmp/shards-exec-test.txt" | FS.Read | String.Trim >= exec-content
  exec-content | Log("swaymsg exec file content")
  exec-content | Assert.Is("swaymsg-ok")
  "Shell command executed and file content verified" | Log

  // Capture frame after shell interactions — terminal should still be visible
  session | Desktop.CaptureFrame
  Pause(0.5)
  session | Desktop.CaptureFrame
  @i2(640 360) | Desktop.Pixel(Session: session)
  | Assert.IsNot(@color(32 74 74 255))
  | Log("Terminal still visible after commands")

  // =========================================================================
  // Phase 5: Test uinput mouse/keyboard injection
  // =========================================================================

  Maybe({
    @i2(100 100) | Desktop.SetMousePos(Session: session)
    @i2(50 50) | Desktop.SetMouseRelativePos(Session: session)
    @i2(200 200) | Desktop.LeftClick(Session: session)
    @i2(200 200) | Desktop.RightClick(Session: session)
    @i2(200 200) | Desktop.MiddleClick(Session: session)
    1.0 | Desktop.ScrollVertical(Session: session)
    -1.0 | Desktop.ScrollHorizontal(Session: session)
    @i2(0 30) | Desktop.SendKeyEvent(Session: session)
    Pause(0.02)
    @i2(1 30) | Desktop.SendKeyEvent(Session: session)

    // Verify capture still works after input injection
    Pause(0.5)
    session | Desktop.CaptureFrame
    Pause(0.5)
    session | Desktop.CaptureFrame
    @i2(10 10) | Desktop.Pixel(Session: session) >= post-input-pixel
    post-input-pixel | Log("Pixel after input injection")

    "Input injection test passed" | Log
  } {
    "Input injection test skipped (uinput not available)" | Log
  })

  "All headless desktop tests passed!" | Log
})

@schedule(root desktop-headless-test)
@run(root) | Assert.Is(true)
