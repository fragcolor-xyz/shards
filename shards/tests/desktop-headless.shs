// Headless desktop test — runs inside a headless sway compositor.
// Uses Desktop.StartSession (portal flow) with auto-approved ScreenCast.
// Launched by test-desktop-headless.sh which sets up the environment.
//
// Sway is configured with:
//   output HEADLESS-1 resolution 1280x720
//   output * bg #204a4a solid_color

@mesh(root)

@wire(desktop-headless-test {
  // =========================================================================
  // Phase 1: Portal session + capture verification
  // =========================================================================

  Desktop.StartSession | Log("Session started") >= session
  session | Desktop.CaptureFrame
  Pause(2.0)
  session | Desktop.CaptureFrame

  // Verify background color #204a4a at edge and center
  @i2(10 10) | Desktop.Pixel(Session: session)
  | Assert.Is(@color(32 74 74 255))
  @i2(640 360) | Desktop.Pixel(Session: session)
  | Assert.Is(@color(32 74 74 255))
  @i2(1270 710) | Desktop.Pixel(Session: session)
  | Assert.Is(@color(32 74 74 255))
  "Background color verified at 3 points" | Log

  // Verify region capture
  @i4(0 0 64 64) | Desktop.Pixels(Session: session) >= region
  region | Log("64x64 region captured")

  // =========================================================================
  // Phase 2: Launch terminal, verify visual change in capture
  // =========================================================================

  // Open foot terminal — verify capture detects visual change
  Maybe({
    "" | Process.Run(Executable: "swaymsg" Arguments: ["exec" "foot"])
  } Pass)
  Pause(1.5)
  session | Desktop.CaptureFrame
  Pause(0.5)
  session | Desktop.CaptureFrame

  @i2(640 360) | Desktop.Pixel(Session: session) >= term-pixel
  term-pixel | Assert.IsNot(@color(32 74 74 255))
  "Terminal opened — screen changed from background" | Log

  // =========================================================================
  // Phase 3: Run shell command in compositor, verify file + visual output
  // =========================================================================

  // Execute a command inside the compositor environment via foot -e.
  // The command writes a file, and we verify the content.
  Maybe({
    "" | Process.Run(
      Executable: "swaymsg"
      Arguments: ["exec" "foot -e bash -c 'echo shards-headless-ok > /tmp/shards-test.txt && sleep 2'"]
    )
  } Pass)
  Pause(1.0)

  // Verify the file was created with correct content
  "/tmp/shards-test.txt" | FS.Read | String.Trim >= file-content
  file-content | Assert.Is("shards-headless-ok")
  "Shell wrote file, content verified" | Log

  // Capture frame — should show the new terminal window with command output
  session | Desktop.CaptureFrame
  Pause(0.5)
  session | Desktop.CaptureFrame

  // The new terminal should be visible (might overlap or tile with the first)
  @i2(640 360) | Desktop.Pixel(Session: session) >= cmd-pixel
  cmd-pixel | Assert.IsNot(@color(32 74 74 255))
  cmd-pixel | Log("Screen with command output")

  // =========================================================================
  // Phase 4: uinput device creation test
  // =========================================================================

  // Verify uinput devices were created (they were during StartSession).
  // In headless mode without libinput, uinput events don't reach sway's seat,
  // but the devices are created and functional at the kernel level.
  Maybe({
    @i2(100 100) | Desktop.SetMousePos(Session: session)
    @i2(50 50) | Desktop.SetMouseRelativePos(Session: session)
    @i2(200 200) | Desktop.LeftClick(Session: session)
    1.0 | Desktop.ScrollVertical(Session: session)
    @i2(0 30) | Desktop.SendKeyEvent(Session: session)
    Pause(0.02)
    @i2(1 30) | Desktop.SendKeyEvent(Session: session)
    "uinput devices functional" | Log
  } {
    "uinput not available" | Log
  })

  "All headless desktop tests passed!" | Log
})

@schedule(root desktop-headless-test)
@run(root) | Assert.Is(true)
