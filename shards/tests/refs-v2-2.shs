@wire(a {
  ; Test indirect requirements, since Once doesn't forward requirements from it's shards block
  Once({
    v = input-ref
  })
  ; Without this line, the below would fail
  Debug.Noop("Pre assign ref")
  v = input-ref
  Debug.WireVariables("after assign refs")
  Inc(input-ref)
  Debug.WireVariables("after increment")
  input-ref
})

@wire(s {
  0 >= v
  Inc(v) | v
} Looped: true)

@wire(main {
  Debug.WireVariables("early")
  1 >= v
  Debug.WireVariables("after assign v")
  
  v | Log("v")
  
  Do(a) = ref0 ; Ref to copy of wire output
  
  Debug.WireVariables("after a and assign ref0")
  
  Log("r0")
  Do(a) = ref1 ; Invalidates ref0
  Log("r1")
  
  Step(s) = ref3 ; Invalidates ref2
  Step(s) = ref2 ; Transient output (from non owned)
  Step(s) = ref4 ; Invalidates ref3 (may be finished output?)
  
  Pause ; Invalidates all refs
  
  v | Log("main")
})

@wire(not-main {
  1 >= v
  Do(a)
  v | Log("not-main")
})

Do(main)
Do(not-main)
