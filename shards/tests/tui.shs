@wire(main {
  Once({
    "Hello" >= hello-text | Log
  })
  
  TUI.VBox({
    TUI.HBox({
      hello-text | TUI.Text
      TUI.Separator
      "World" | TUI.Text
    })
    "Click me" | TUI.Button({
      "Ciao" > hello-text | Log
    })
  }) ; | TUI.Render | Process.StdOut
  TUI.Tick
} Looped: true)

@mesh(root)
@schedule(root main)
@run(root FPS: 10
; Iterations: 10
)
