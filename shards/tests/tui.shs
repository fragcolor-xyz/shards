@wire(main {
  Once({
    "Hello" >= hello-text | Log
  })
  
  TUI.VBox({
    TUI.HBox({
      hello-text | TUI.Text
      TUI.Separator
      "World" | TUI.Text
    })
    "Click me" | TUI.Button({
      "Ciao" > hello-text | Log
    })
  }) ; | TUI.Render | Process.StdOut
  TUI.Tick
  
  ; Once({
  ;   RandomInt | ToString = text | Log
  ; } Every: 2.0)
  
  ; text | Memoize(TUI.VBox({
  ;   TUI.HBox({
  ;     text | TUI.Text
  ;     TUI.Separator
  ;     "World" | TUI.Text
  ;   })
  ; })) ;  | TUI.Render | Process.StdOut
  ; TUI.Tick
} Looped: true)

@mesh(root)
@schedule(root main)
@run(root FPS: 10
; Iterations: 10
)
