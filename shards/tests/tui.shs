@wire(main {
  Once({
    "Hello" | Set(hello-text TrackingMask: 1)
    0 >= counter
    "" >= text
  })
  
  Track([hello-text] {
    Inc(counter)
    TUI.VBox({
      TUI.HBox({
        hello-text | TUI.Text(Border: true BackgroundColor: @color(0x01010190))
        "World" | TUI.Text(Border: true Flex: true AlignRight: true Color: @color(0xFF0000FF))
        counter | ToString | TUI.Text(Border: true)
      })
      "Click me 1" | TUI.Button({
        "Ciao 1" > hello-text | Log
      })
      "Click me 2" | TUI.Button({
        "Ciao 2" > hello-text | Log
      })
      TUI.Input(text OnEnter: {
        text > hello-text
      })
    })
  }) | TUI.RunOnce
  
  text | Memoize(Log)
  
  ; hello-text | Memoize(TUI.VBox({
  ;   TUI.HBox({
  ;     hello-text | TUI.Text
  ;     TUI.Separator
  ;     "World" | TUI.Text
  ;   })
  ;   "Click me 1" | TUI.Button({
  ;     "Ciao 1" > hello-text | Log
  ;   })
  ;   "Click me 2" | TUI.Button({
  ;     "Ciao 2" > hello-text | Log
  ;   })
  ; })) | TUI.Tick
  
  ; | TUI.Render | Process.StdOut
  
  ; Once({
  ;   RandomInt | ToString = text | Log
  ; } Every: 2.0)
  
  ; text | Memoize(TUI.VBox({
  ;   TUI.HBox({
  ;     text | TUI.Text
  ;     TUI.Separator
  ;     "World" | TUI.Text
  ;   })
  ; })) ;  | TUI.Render | Process.StdOut
  ; TUI.Tick
} Looped: true)

@mesh(root)
@schedule(root main)
@run(root FPS: 30
; Iterations: 10
)
