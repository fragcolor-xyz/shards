@wire(main {
  Once({
    "Hello" | Set(hello-text TrackingMask: 1)
    0 >= counter
    "" >= text
    "abc" | Set(second-var TrackingMask: 22)
  })
  
  Track([hello-text second-var] {
    Inc(counter)
    TUI.VBox({
      TUI.HBox({
        hello-text | TUI.Text(BackgroundColor: @color(0x01010190)) | TUI.Flex | TUI.Border
        "World" | TUI.Text(Color: @color(0xFF0000FF)) | TUI.AlignedRight | TUI.Flex | TUI.Border
        counter | ToString | TUI.Text | TUI.Flex | TUI.Border
      })
      
      TUI.Filler
      
      "Click me 1" | TUI.Button({
        "Ciao 1" > hello-text | Log
      })
      
      TUI.Filler
      
      "Click me 2" | TUI.Button({
        "Ciao 2" > hello-text | Log
      })
      
      TUI.Filler
      
      TUI.Input(text OnEnter: {
        text > hello-text
      })
      
      TUI.Filler

      Track(second-var {
        second-var | TUI.Text
      } Mask: 22)
    })
  }) | TUI.RunOnce

  Once({
    "Ciao Mondo" > hello-text
    "def" > second-var
  })
  
  ; Track([hello-text] {
  ;   Inc(counter)
  
  ;   TUI.HBox({
  ;     hello-text | TUI.Text(Border: true BackgroundColor: @color(0x01010190))
  ;     "World" | TUI.Text(Border: true Flex: true AlignRight: true Color: @color(0xFF0000FF))
  ;     counter | ToString | TUI.Text(Border: true)
  ;   }) = top
  
  ;   TUI.VBox({
  ;     "Click me 1" | TUI.Button({
  ;       "Ciao 1" > hello-text | Log
  ;     })
  
  ;     TUI.Separator
  
  ;     "Click me 2" | TUI.Button({
  ;       "Ciao 2" > hello-text | Log
  ;     })
  
  ;     TUI.Separator
  
  ;     TUI.Input(text OnEnter: {
  ;       text > hello-text
  ;     })
  ;   }) | TUI.Split(Top: top InitialSize: @i4(0 0 20 0))
  ; }) | TUI.RunOnce
  
  ; text | Memoize(Log)
  
  ; hello-text | Memoize(TUI.VBox({
  ;   TUI.HBox({
  ;     hello-text | TUI.Text
  ;     TUI.Separator
  ;     "World" | TUI.Text
  ;   })
  ;   "Click me 1" | TUI.Button({
  ;     "Ciao 1" > hello-text | Log
  ;   })
  ;   "Click me 2" | TUI.Button({
  ;     "Ciao 2" > hello-text | Log
  ;   })
  ; })) | TUI.Tick
  
  ; | TUI.Render | Process.StdOut
  
  ; Once({
  ;   RandomInt | ToString = text | Log
  ; } Every: 2.0)
  
  ; text | Memoize(TUI.VBox({
  ;   TUI.HBox({
  ;     text | TUI.Text
  ;     TUI.Separator
  ;     "World" | TUI.Text
  ;   })
  ; })) ;  | TUI.Render | Process.StdOut
  ; TUI.Tick
} Looped: true)

@mesh(root)
@schedule(root main)
@run(root FPS: 30
Iterations: 10)
