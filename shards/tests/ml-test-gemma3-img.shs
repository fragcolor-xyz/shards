; Minimal single-image vision test using the canonical Jinja.Apply pipeline.
; A %%__IMG_PLACEHOLDER__%% sentinel marks the image's position inside the
; user message. After Jinja.Apply renders the template, we split on the
; sentinel and interleave AddText/AddImage. mtmd_tokenize inserts the
; model-specific image boundary tokens internally.

@define(text-model "/Users/sugar/.cache/lm-studio/models/lmstudio-community/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_K_M.gguf" IgnoreRedefined: true)
@define(image-model "/Users/sugar/.cache/lm-studio/models/lmstudio-community/gemma-4-E2B-it-GGUF/mmproj-gemma-4-E2B-it-BF16.gguf" IgnoreRedefined: true)
@define(test-image "/Users/sugar/devel/shards/assets/simple1.PNG" IgnoreRedefined: true)

@define(image-sentinel "%%__IMG_PLACEHOLDER__%%")

@text-model | LLM.Model(UseMmap: false GPULayers: 1000) = model
LLM.Chat(MMProj: @image-model) = chat-context
chat-context | LLM.Template = chat-template

chat-context | LLM.AddBos

LoadImage(@test-image) | StripAlpha = image

{
  bos_token: ""              ; LLM.AddBos handles BOS manually
  add_generation_prompt: true
  messages: [{
    role: "user"
    content: ["What is in this image? " @image-sentinel] | String.Join
  }]
} | Jinja.Apply(chat-template) = rendered-prompt
rendered-prompt | Log("Rendered prompt")

rendered-prompt | String.Split(@image-sentinel) = segments
; One sentinel ⇒ two segments. Interleave: text0, image, text1.
segments | Take(0) | ExpectString | LLM.AddText(chat-context)
image | LLM.AddImage(chat-context)
segments | Take(1) | ExpectString | LLM.AddText(chat-context NeedLogits: true)

Sequence(tokens Type: @type([Type::String]))
Repeat({
  chat-context | LLM.Generate(Temperature: 0.5) | Log("Generated token")
  If(Is("") Return Pass) >> tokens
} Times: 512)

tokens | String.Join | String.Trim | Log("Response")
