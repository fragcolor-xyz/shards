; Audio math operations test suite

@wire(test-audio-binary {
  Msg("Testing Audio Math Binary Operations...")

  ; Generate test audio samples using oscillators
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 1024) = audio1
  none | Audio.Oscillator(Frequency: 880.0 SampleRate: 44100 Amplitude: 0.3 Samples: 1024) = audio2

  ; === Test Audio + Audio ===
  audio1 | Math.Add(audio2) = sum-audio
  sum-audio | Log("Add: Audio + Audio")

  ; === Test Audio - Audio ===
  audio1 | Math.Subtract(audio2) = diff-audio
  diff-audio | Log("Subtract: Audio - Audio")

  ; Self subtraction should give zeros
  audio1 | Math.Subtract(audio1) = zero-audio
  zero-audio | Log("Subtract: Audio - Self (should be zeros)")

  ; === Test Audio * Audio ===
  audio1 | Math.Multiply(audio2) = mul-audio
  mul-audio | Log("Multiply: Audio * Audio")

  ; === Test Audio / Audio ===
  audio1 | Math.Divide(audio2) = div-audio
  div-audio | Log("Divide: Audio / Audio")

  ; === Test Audio + Float (DC offset) ===
  audio1 | Math.Add(0.1) = offset-audio
  offset-audio | Log("Add: Audio + 0.1 (DC offset)")

  ; === Test Audio - Float ===
  audio1 | Math.Subtract(0.1) = sub-scalar-audio
  sub-scalar-audio | Log("Subtract: Audio - 0.1")

  ; === Test Audio * Float (gain control) ===
  audio1 | Math.Multiply(0.5) = half-audio
  half-audio | Log("Multiply: Audio * 0.5 (gain)")

  audio1 | Math.Multiply(2.0) = double-audio
  double-audio | Log("Multiply: Audio * 2.0 (boost)")

  ; === Test Audio / Float ===
  audio1 | Math.Divide(2.0) = div-scalar-audio
  div-scalar-audio | Log("Divide: Audio / 2.0")

  Msg("Audio binary operations test passed!")
})

@wire(test-audio-unary {
  Msg("Testing Audio Math Unary Operations...")

  ; Generate test audio - use sine wave with known values
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.8 Samples: 512) = audio

  ; === Trigonometric ===
  audio | Math.Sin = sin-audio
  sin-audio | Log("Sin(audio)")

  audio | Math.Cos = cos-audio
  cos-audio | Log("Cos(audio)")

  audio | Math.Tan = tan-audio
  tan-audio | Log("Tan(audio)")

  ; === Inverse Trigonometric (input should be in [-1, 1]) ===
  audio | Math.Asin = asin-audio
  asin-audio | Log("Asin(audio)")

  audio | Math.Acos = acos-audio
  acos-audio | Log("Acos(audio)")

  audio | Math.Atan = atan-audio
  atan-audio | Log("Atan(audio)")

  ; === Hyperbolic ===
  audio | Math.Sinh = sinh-audio
  sinh-audio | Log("Sinh(audio)")

  audio | Math.Cosh = cosh-audio
  cosh-audio | Log("Cosh(audio)")

  audio | Math.Tanh = tanh-audio
  tanh-audio | Log("Tanh(audio)")

  ; === Inverse Hyperbolic ===
  audio | Math.Asinh = asinh-audio
  asinh-audio | Log("Asinh(audio)")

  ; For Acosh, input must be >= 1, so use offset audio
  audio | Math.Add(2.0) | Math.Acosh = acosh-audio
  acosh-audio | Log("Acosh(audio+2)")

  audio | Math.Atanh = atanh-audio
  atanh-audio | Log("Atanh(audio)")

  ; === Exponential and Logarithmic ===
  audio | Math.Exp = exp-audio
  exp-audio | Log("Exp(audio)")

  audio | Math.Exp2 = exp2-audio
  exp2-audio | Log("Exp2(audio)")

  audio | Math.Expm1 = expm1-audio
  expm1-audio | Log("Expm1(audio)")

  ; For Log, input must be > 0, use abs + small offset
  audio | Math.Multiply(audio) | Math.Add(0.1) | Math.Log = log-audio
  log-audio | Log("Log(audio^2+0.1)")

  audio | Math.Multiply(audio) | Math.Add(0.1) | Math.Log10 = log10-audio
  log10-audio | Log("Log10(audio^2+0.1)")

  audio | Math.Multiply(audio) | Math.Add(0.1) | Math.Log2 = log2-audio
  log2-audio | Log("Log2(audio^2+0.1)")

  audio | Math.Log1p = log1p-audio
  log1p-audio | Log("Log1p(audio)")

  ; === Root functions ===
  audio | Math.Multiply(audio) | Math.Sqrt = sqrt-audio
  sqrt-audio | Log("Sqrt(audio^2)")

  audio | Math.Cbrt = cbrt-audio
  cbrt-audio | Log("Cbrt(audio)")

  ; === Rounding ===
  audio | Math.Ceil = ceil-audio
  ceil-audio | Log("Ceil(audio)")

  audio | Math.Floor = floor-audio
  floor-audio | Log("Floor(audio)")

  audio | Math.Trunc = trunc-audio
  trunc-audio | Log("Trunc(audio)")

  audio | Math.Round = round-audio
  round-audio | Log("Round(audio)")

  ; === Error functions ===
  audio | Math.Erf = erf-audio
  erf-audio | Log("Erf(audio)")

  audio | Math.Erfc = erfc-audio
  erfc-audio | Log("Erfc(audio)")

  Msg("Audio unary operations test passed!")
})

@wire(test-audio-chain {
  Msg("Testing Audio Math Chain Operations...")

  ; Generate test audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 256) = audio

  ; Chain multiple operations: (audio * 2.0 + 0.1) * 0.5
  audio
  | Math.Multiply(2.0)
  | Math.Add(0.1)
  | Math.Multiply(0.5) = chain-result
  chain-result | Log("Chain: (audio * 2 + 0.1) * 0.5")

  ; Apply sin to audio, then square it
  audio | Math.Sin | Math.Multiply(audio | Math.Sin) = sin-squared
  sin-squared | Log("Chain: sin(audio)^2")

  ; Tanh for soft clipping
  audio | Math.Multiply(3.0) | Math.Tanh = soft-clip
  soft-clip | Log("Chain: tanh(audio * 3) (soft clip)")

  Msg("Audio chain operations test passed!")
})

; ============================================================================
; Audio Collection Operations Tests (AppendTo, PrependTo, Slice, Pad, Trim)
; ============================================================================

@wire(test-audio-append-prepend {
  Msg("Testing Audio AppendTo/PrependTo...")

  ; Generate test audio samples
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = audio1
  none | Audio.Oscillator(Frequency: 880.0 SampleRate: 44100 Amplitude: 0.3 Samples: 50) = audio2

  ; === Test AppendTo - basic case ===
  audio1 | Set(collection)
  audio2 | AppendTo(collection)
  collection | Log("AppendTo result (should have 150 samples)")

  ; === Test PrependTo - basic case ===
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) | Set(collection2)
  none | Audio.Oscillator(Frequency: 880.0 SampleRate: 44100 Amplitude: 0.3 Samples: 50) | PrependTo(collection2)
  collection2 | Log("PrependTo result (should have 150 samples)")

  ; === Test multiple append operations (buffer reuse) ===
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 10) | Set(multi-append)
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 5) = small-audio
  small-audio | AppendTo(multi-append)
  small-audio | AppendTo(multi-append)
  small-audio | AppendTo(multi-append)
  multi-append | Log("Multiple appends (should have 25 samples)")

  ; === Test mono audio ===
  ; TODO: Test mono when Audio.Oscillator supports it

  Msg("Audio AppendTo/PrependTo tests passed!")
})

@wire(test-audio-slice {
  Msg("Testing Audio Slice...")

  ; Generate test audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 1.0 Samples: 100) = audio

  ; === Basic slice (From and To) ===
  audio | Slice(From: 10 To: 50) = sliced
  sliced | Log("Sliced audio (40 samples from index 10-50)")

  ; === Slice from beginning (To only) ===
  audio | Slice(To: 30) = front-slice
  front-slice | Log("Front slice (first 30 samples)")

  ; === Slice to end (From only) ===
  audio | Slice(From: 70) = back-slice
  back-slice | Log("Back slice (last 30 samples)")

  ; === Negative indices (from end) ===
  audio | Slice(From: -20) = last-20
  last-20 | Log("Last 20 samples using negative index")

  audio | Slice(From: -50 To: -10) = neg-slice
  neg-slice | Log("Slice with negative from and to (-50 to -10)")

  ; === Slice with step ===
  audio | Slice(From: 0 To: 50 Step: 2) = stepped
  stepped | Log("Every other sample (25 samples)")

  audio | Slice(From: 0 To: 60 Step: 3) = stepped-3
  stepped-3 | Log("Every 3rd sample (20 samples)")

  ; === Edge cases ===
  audio | Slice(From: 0 To: 100) = full-copy
  full-copy | Log("Full slice (100 samples)")

  audio | Slice(From: 50 To: 50) = empty-slice
  empty-slice | Log("Empty slice (0 samples from 50-50)")

  Msg("Audio Slice tests passed!")
})

@wire(test-audio-pad {
  Msg("Testing Pad for Audio...")

  ; Generate test audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = audio

  ; === Pad at beginning only ===
  audio | Pad(Before: 50) = padded-before
  padded-before | Log("Audio padded at beginning (150 samples)")

  ; === Pad at end only ===
  audio | Pad(After: 50) = padded-after
  padded-after | Log("Audio padded at end (150 samples)")

  ; === Pad both ends ===
  audio | Pad(Before: 25 After: 25) = padded-both
  padded-both | Log("Audio padded both ends (150 samples)")

  ; === Zero padding (default values) ===
  audio | Pad(Before: 0 After: 0) = no-pad
  no-pad | Log("No padding (100 samples)")

  ; === Large padding ===
  audio | Pad(Before: 1000 After: 1000) = large-pad
  large-pad | Log("Large padding (2100 samples)")

  Msg("Audio Pad tests passed!")
})

@wire(test-audio-trim {
  Msg("Testing Trim for Audio...")

  ; Generate test audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = audio

  ; === Trim from beginning only ===
  audio | Trim(Before: 20) = trimmed-before
  trimmed-before | Log("Audio trimmed at beginning (80 samples)")

  ; === Trim from end only ===
  audio | Trim(After: 20) = trimmed-after
  trimmed-after | Log("Audio trimmed at end (80 samples)")

  ; === Trim both ends ===
  audio | Trim(Before: 10 After: 10) = trimmed-both
  trimmed-both | Log("Audio trimmed both ends (80 samples)")

  ; === Zero trim (no change) ===
  audio | Trim(Before: 0 After: 0) = no-trim
  no-trim | Log("No trim (100 samples)")

  ; === Trim to near-empty ===
  audio | Trim(Before: 49 After: 50) = almost-empty
  almost-empty | Log("Nearly empty audio (1 sample)")

  Msg("Audio Trim tests passed!")
})

@wire(test-pad-seq {
  Msg("Testing Pad for Seq...")

  ; === Seq with default pad value (None) ===
  [1 2 3] | Pad(Before: 2 After: 2) = padded-default
  padded-default | Log("Padded sequence with default (None)")

  ; === Seq with custom pad value ===
  [1 2 3] | Pad(Before: 2 After: 2 Value: 0) = padded-zero
  padded-zero | Log("Padded sequence with 0")
  padded-zero | Assert.Is([0 0 1 2 3 0 0])

  ; === Seq with string pad value ===
  ["a" "b"] | Pad(Before: 1 After: 1 Value: "x") = padded-str
  padded-str | Log("Padded string sequence")
  padded-str | Assert.Is(["x" "a" "b" "x"])

  ; === Pad only before ===
  [1 2 3] | Pad(Before: 3 Value: -1) = pad-before
  pad-before | Assert.Is([-1 -1 -1 1 2 3])

  ; === Pad only after ===
  [1 2 3] | Pad(After: 3 Value: -1) = pad-after
  pad-after | Assert.Is([1 2 3 -1 -1 -1])

  Msg("Pad Seq tests passed!")
})

@wire(test-pad-string {
  Msg("Testing Pad for String...")

  ; === Default padding (spaces) ===
  "hi" | Pad(Before: 2 After: 2) = space-padded
  space-padded | Log("Space padded string")
  space-padded | Assert.Is("  hi  ")

  ; === Custom character padding ===
  "hello" | Pad(Before: 3 After: 3 Value: "*") = star-padded
  star-padded | Log("Star padded string")
  star-padded | Assert.Is("***hello***")

  ; === Only before ===
  "test" | Pad(Before: 5 Value: "-") = before-only
  before-only | Assert.Is("-----test")

  ; === Only after ===
  "test" | Pad(After: 5 Value: "-") = after-only
  after-only | Assert.Is("test-----")

  ; === Single char from longer string ===
  "abc" | Pad(Before: 2 After: 2 Value: "xyz") = first-char
  first-char | Log("Uses first char of pad string")
  first-char | Assert.Is("xxabcxx")

  Msg("Pad String tests passed!")
})

@wire(test-pad-bytes {
  Msg("Testing Pad for Bytes...")

  ; === Default zero padding ===
  "AB" | StringToBytes | Pad(Before: 2 After: 2) = zero-padded
  zero-padded | Log("Zero padded bytes")

  ; === Custom byte from Int ===
  "test" | StringToBytes | Pad(Before: 2 After: 2 Value: 255) = int-padded
  int-padded | Log("Padded with 0xFF from Int")

  ; === Custom byte from Bytes ===
  "CD" | StringToBytes | Pad(Before: 1 After: 1 Value: ("X" | StringToBytes)) = bytes-padded
  bytes-padded | BytesToString | Assert.Is("XCDX")

  Msg("Pad Bytes tests passed!")
})

@wire(test-trim-seq {
  Msg("Testing Trim for Seq...")

  ; === Basic trim ===
  [0 0 1 2 3 0 0] | Trim(Before: 2 After: 2) = trimmed
  trimmed | Log("Trimmed sequence")
  trimmed | Assert.Is([1 2 3])

  ; === Trim only before ===
  [1 2 3 4 5] | Trim(Before: 2) = trim-before
  trim-before | Assert.Is([3 4 5])

  ; === Trim only after ===
  [1 2 3 4 5] | Trim(After: 2) = trim-after
  trim-after | Assert.Is([1 2 3])

  ; === Zero trim ===
  [1 2 3] | Trim(Before: 0 After: 0) = no-trim
  no-trim | Assert.Is([1 2 3])

  ; === Trim to single element ===
  [1 2 3 4 5] | Trim(Before: 2 After: 2) = single
  single | Assert.Is([3])

  Msg("Trim Seq tests passed!")
})

@wire(test-trim-string {
  Msg("Testing Trim for String...")

  ; === Basic trim ===
  "***hello***" | Trim(Before: 3 After: 3) = trimmed
  trimmed | Log("Trimmed string")
  trimmed | Assert.Is("hello")

  ; === Trim only before ===
  "xxxtest" | Trim(Before: 3) = trim-before
  trim-before | Assert.Is("test")

  ; === Trim only after ===
  "testyyy" | Trim(After: 3) = trim-after
  trim-after | Assert.Is("test")

  ; === Zero trim ===
  "hello" | Trim(Before: 0 After: 0) = no-trim
  no-trim | Assert.Is("hello")

  ; === Trim to single char ===
  "xxAxx" | Trim(Before: 2 After: 2) = single-char
  single-char | Assert.Is("A")

  Msg("Trim String tests passed!")
})

@wire(test-trim-bytes {
  Msg("Testing Trim for Bytes...")

  ; === Basic trim ===
  "##test##" | StringToBytes | Trim(Before: 2 After: 2) = trimmed
  trimmed | BytesToString | Assert.Is("test")

  ; === Trim only before ===
  "XXXdata" | StringToBytes | Trim(Before: 3) = trim-before
  trim-before | BytesToString | Assert.Is("data")

  ; === Trim only after ===
  "dataYYY" | StringToBytes | Trim(After: 3) = trim-after
  trim-after | BytesToString | Assert.Is("data")

  Msg("Trim Bytes tests passed!")
})

@wire(test-audio-workflow {
  Msg("Testing audio mixing workflow with Pad + Math.Add...")

  ; Create two audio buffers of different lengths
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = short-audio
  none | Audio.Oscillator(Frequency: 880.0 SampleRate: 44100 Amplitude: 0.3 Samples: 150) = long-audio

  ; Pad the short audio to match the long audio
  short-audio | Pad(After: 50) = padded-short

  ; Now mix them using Math.Add
  padded-short | Math.Add(long-audio) = mixed
  mixed | Log("Mixed audio (150 samples)")

  ; Test concatenation workflow
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 50) | Set(concat-audio)
  none | Audio.Oscillator(Frequency: 880.0 SampleRate: 44100 Amplitude: 0.5 Samples: 50) | AppendTo(concat-audio)
  none | Audio.Oscillator(Frequency: 660.0 SampleRate: 44100 Amplitude: 0.5 Samples: 50) | AppendTo(concat-audio)
  concat-audio | Log("Concatenated audio (150 samples)")

  ; Test slice + pad workflow (extract and pad to original size)
  concat-audio | Slice(From: 50 To: 100) = middle-section
  middle-section | Pad(Before: 50 After: 50) = restored-size
  restored-size | Log("Extracted middle, padded back to 150 samples")

  Msg("Audio workflow tests passed!")
})

; === Error condition tests ===

@wire(test-error-channel-mismatch {
  Msg("Testing error: channel mismatch...")

  ; Create mono and stereo audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100 Channels: 1) = mono
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100 Channels: 2) = stereo

  ; Try to append stereo to mono - should fail
  mono | Set(collection)
  Maybe({
    stereo | AppendTo(collection)
    "ERROR: Should have thrown channel mismatch!" | Fail
  } {
    Msg("Correctly caught channel mismatch error in AppendTo")
  })

  ; Try to prepend stereo to mono - should fail
  mono | Set(collection2)
  Maybe({
    stereo | PrependTo(collection2)
    "ERROR: Should have thrown channel mismatch!" | Fail
  } {
    Msg("Correctly caught channel mismatch error in PrependTo")
  })

  Msg("Channel mismatch error tests passed!")
})

@wire(test-error-samplerate-mismatch {
  Msg("Testing error: sample rate mismatch...")

  ; Create audio with different sample rates
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = audio44k
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 48000 Amplitude: 0.5 Samples: 100) = audio48k

  ; Try to append different sample rates - should fail
  audio44k | Set(collection)
  Maybe({
    audio48k | AppendTo(collection)
    "ERROR: Should have thrown sample rate mismatch!" | Fail
  } {
    Msg("Correctly caught sample rate mismatch error in AppendTo")
  })

  ; Try to prepend different sample rates - should fail
  audio44k | Set(collection2)
  Maybe({
    audio48k | PrependTo(collection2)
    "ERROR: Should have thrown sample rate mismatch!" | Fail
  } {
    Msg("Correctly caught sample rate mismatch error in PrependTo")
  })

  Msg("Sample rate mismatch error tests passed!")
})

@wire(test-error-trim-overflow {
  Msg("Testing error: trim overflow...")

  ; Create short audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 10) = short-audio

  ; Try to trim more than available - should fail
  Maybe({
    short-audio | Trim(Before: 6 After: 6)
    "ERROR: Should have thrown trim overflow!" | Fail
  } {
    Msg("Correctly caught trim overflow error")
  })

  ; Test exact trim to empty - this is valid (results in 0 samples)
  short-audio | Trim(Before: 5 After: 5) = empty-audio
  empty-audio | Log("Trimmed to 0 samples (valid)")

  Msg("Trim overflow error tests passed!")
})

@wire(test-error-negative-params {
  Msg("Testing error: negative parameters...")

  ; Create test audio
  none | Audio.Oscillator(Frequency: 440.0 SampleRate: 44100 Amplitude: 0.5 Samples: 100) = audio

  ; Test negative Before in Pad - should fail
  Maybe({
    audio | Pad(Before: -1 After: 0)
    "ERROR: Should have thrown negative param error!" | Fail
  } {
    Msg("Correctly caught negative Before in Pad")
  })

  ; Test negative After in Pad - should fail
  Maybe({
    audio | Pad(Before: 0 After: -1)
    "ERROR: Should have thrown negative param error!" | Fail
  } {
    Msg("Correctly caught negative After in Pad")
  })

  ; Test negative Before in Trim - should fail
  Maybe({
    audio | Trim(Before: -1 After: 0)
    "ERROR: Should have thrown negative param error!" | Fail
  } {
    Msg("Correctly caught negative Before in Trim")
  })

  ; Test negative After in Trim - should fail
  Maybe({
    audio | Trim(Before: 0 After: -1)
    "ERROR: Should have thrown negative param error!" | Fail
  } {
    Msg("Correctly caught negative After in Trim")
  })

  Msg("Negative parameter error tests passed!")
})

; ============================================================================
; Audio.Oscillator (FM Synthesis) Tests
; ============================================================================

@wire(test-audio-fm-carrier {
  Msg("Testing Audio.Oscillator carrier mode...")

  ; Generate FM carrier (no modulation input) - uses default sample rate 44100
  none | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.5 Samples: 256) = fm-carrier
  fm-carrier | Log("FM carrier at 440Hz")

  ; Test with different frequencies
  none | Audio.Oscillator(Frequency: 880.0 Amplitude: 0.3 Samples: 256) = fm-high
  fm-high | Log("FM carrier at 880Hz")

  ; Test stereo
  none | Audio.Oscillator(Frequency: 440.0 Channels: 2 Samples: 128) = fm-stereo
  fm-stereo | Log("FM carrier stereo")

  Msg("Audio.Oscillator carrier tests passed!")
})

@wire(test-audio-fm-modulated {
  Msg("Testing Audio.Oscillator modulated mode...")

  ; Simple FM: modulator -> carrier
  none | Audio.Oscillator(Frequency: 220.0 Amplitude: 1.0 Samples: 256)
       | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.5 Index: 2.0) = fm-simple
  fm-simple | Log("Simple FM (220Hz mod -> 440Hz carrier)")

  ; Different modulation indices
  none | Audio.Oscillator(Frequency: 110.0 Amplitude: 1.0 Samples: 256)
       | Audio.Oscillator(Frequency: 440.0 Index: 0.5) = fm-low-index
  fm-low-index | Log("FM with low modulation index (0.5)")

  none | Audio.Oscillator(Frequency: 110.0 Amplitude: 1.0 Samples: 256)
       | Audio.Oscillator(Frequency: 440.0 Index: 5.0) = fm-high-index
  fm-high-index | Log("FM with high modulation index (5.0)")

  Msg("Audio.Oscillator modulated tests passed!")
})

@wire(test-audio-fm-chain {
  Msg("Testing Audio.Oscillator chain (DX7-style)...")

  ; 3-operator chain
  none | Audio.Oscillator(Frequency: 880.0 Amplitude: 0.5 Samples: 256)
       | Audio.Oscillator(Frequency: 440.0 Index: 1.5)
       | Audio.Oscillator(Frequency: 220.0 Amplitude: 0.4 Index: 2.0) = fm-3op
  fm-3op | Log("3-operator FM chain")

  ; 4-operator chain
  none | Audio.Oscillator(Frequency: 1760.0 Amplitude: 0.3 Samples: 256)
       | Audio.Oscillator(Frequency: 880.0 Index: 1.0)
       | Audio.Oscillator(Frequency: 440.0 Index: 1.5)
       | Audio.Oscillator(Frequency: 220.0 Amplitude: 0.3 Index: 2.0) = fm-4op
  fm-4op | Log("4-operator FM chain")

  Msg("Audio.Oscillator chain tests passed!")
})

@wire(test-audio-fm-math {
  Msg("Testing Audio.Oscillator with math operations...")

  ; FM output can be processed by math shards
  none | Audio.Oscillator(Frequency: 440.0 Amplitude: 1.0 Samples: 128)
       | Math.Multiply(0.5) = fm-scaled
  fm-scaled | Log("FM output scaled by 0.5")

  ; FM + FM mixing
  none | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.3 Samples: 128) = fm1
  none | Audio.Oscillator(Frequency: 550.0 Amplitude: 0.3 Samples: 128) = fm2
  fm1 | Math.Add(fm2) = fm-mixed
  fm-mixed | Log("Two FM operators mixed")

  ; Apply tanh for soft clipping
  none | Audio.Oscillator(Frequency: 440.0 Amplitude: 2.0 Samples: 128)
       | Math.Tanh = fm-clipped
  fm-clipped | Log("FM with tanh soft clipping")

  Msg("Audio.Oscillator math tests passed!")
})

; ============================================================================
; Audio.Noise Tests
; ============================================================================

@wire(test-audio-noise-types {
  Msg("Testing Audio.Noise types...")

  ; White noise
  none | Audio.Noise(Type: NoiseType::White Amplitude: 0.5 Samples: 256) = white
  white | Log("White noise")

  ; Pink noise (1/f spectrum)
  none | Audio.Noise(Type: NoiseType::Pink Amplitude: 0.5 Samples: 256) = pink
  pink | Log("Pink noise")

  ; Brown noise (1/f^2 spectrum)
  none | Audio.Noise(Type: NoiseType::Brown Amplitude: 0.5 Samples: 256) = brown
  brown | Log("Brown noise")

  Msg("Audio.Noise type tests passed!")
})

@wire(test-audio-noise-stereo {
  Msg("Testing Audio.Noise stereo...")

  ; Stereo white noise (independent channels)
  none | Audio.Noise(Type: NoiseType::White Channels: 2 Samples: 128) = stereo-white
  stereo-white | Log("Stereo white noise")

  ; Stereo pink noise (coherent channels)
  none | Audio.Noise(Type: NoiseType::Pink Channels: 2 Samples: 128) = stereo-pink
  stereo-pink | Log("Stereo pink noise")

  Msg("Audio.Noise stereo tests passed!")
})

@wire(test-audio-noise-math {
  Msg("Testing Audio.Noise with math operations...")

  ; Scale noise
  none | Audio.Noise(Type: NoiseType::White Amplitude: 1.0 Samples: 128)
       | Math.Multiply(0.25) = noise-scaled
  noise-scaled | Log("Noise scaled to 0.25")

  ; Filter noise with simple operations
  none | Audio.Noise(Type: NoiseType::White Samples: 128)
       | Math.Tanh = noise-shaped
  noise-shaped | Log("Noise shaped with tanh")

  ; Mix noise with oscillator
  none | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.5 Samples: 128) = osc
  none | Audio.Noise(Type: NoiseType::Pink Amplitude: 0.1 Samples: 128) = noise
  osc | Math.Add(noise) = osc-with-noise
  osc-with-noise | Log("Oscillator + pink noise")

  Msg("Audio.Noise math tests passed!")
})

@wire(test-audio-fm-noise-combo {
  Msg("Testing FM + Noise combinations...")

  ; Use noise to modulate FM (noise modulation)
  none | Audio.Noise(Type: NoiseType::White Amplitude: 0.5 Samples: 128)
       | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.3 Index: 0.5) = noise-fm
  noise-fm | Log("Noise-modulated FM")

  ; FM + noise mix for richer timbre
  none | Audio.Oscillator(Frequency: 110.0 Amplitude: 1.0 Samples: 128)
       | Audio.Oscillator(Frequency: 440.0 Amplitude: 0.4 Index: 3.0) = fm-bass
  none | Audio.Noise(Type: NoiseType::Pink Amplitude: 0.1 Samples: 128) = breath
  fm-bass | Math.Add(breath) = fm-with-breath
  fm-with-breath | Log("FM bass with breath noise")

  Msg("FM + Noise combo tests passed!")
})

@mesh(main)
@schedule(main test-audio-binary)
@schedule(main test-audio-unary)
@schedule(main test-audio-chain)
@schedule(main test-audio-append-prepend)
@schedule(main test-audio-slice)
@schedule(main test-audio-pad)
@schedule(main test-audio-trim)
@schedule(main test-pad-seq)
@schedule(main test-pad-string)
@schedule(main test-pad-bytes)
@schedule(main test-trim-seq)
@schedule(main test-trim-string)
@schedule(main test-trim-bytes)
@schedule(main test-audio-workflow)
@schedule(main test-error-channel-mismatch)
@schedule(main test-error-samplerate-mismatch)
@schedule(main test-error-trim-overflow)
@schedule(main test-error-negative-params)
@schedule(main test-audio-fm-carrier)
@schedule(main test-audio-fm-modulated)
@schedule(main test-audio-fm-chain)
@schedule(main test-audio-fm-math)
@schedule(main test-audio-noise-types)
