@wire(parser {
  @read("../../README.md") | Markdown.Parse
})

Repeat({
  Do(parser) | Log
  When(Is([]) Return)
})

none | Http.Get("https://github.com/fragcolor-xyz/shards") | 
Markdown.FromHTML(SkipTags: ["script" "style" "nav" "header" "fooder" "aside" "noscript" "iframe"]) = md

"md.md" | FS.Write(md Overwrite: true)

"""
foo
bar
baz
qux
""" = codex-test
"codex-test.txt" | FS.Write(codex-test Overwrite: true)

"""*** Begin Patch
*** Update File: codex-test.txt
@@
 foo
-bar
+BAR
@@
 baz
-qux
+QUX
*** End Patch""" | Codex.ApplyPatch | Log

// Grep tests
"""The quick brown fox jumps over the lazy dog.
The QUICK brown FOX jumps again.
Lorem ipsum dolor sit amet.
Another line with FOX in it.
Quick thinking saves the day.
This is line six.
This is line seven.
Final line with nothing special.""" = grep-test-content

"grep-test.txt" | FS.Write(grep-test-content Overwrite: true)

// Test 1: Basic pattern search
"fox" | Grep(File: "grep-test.txt") = matches
matches | Log("Basic search for 'fox'")

// Test 2: Case insensitive search
"fox" | Grep(File: "grep-test.txt" CaseInsensitive: true) = ci-matches
ci-matches | Log("Case insensitive 'fox'")

// Test 3: With context lines
"FOX" | Grep(File: "grep-test.txt" BeforeContext: 1 AfterContext: 1) = context-matches
context-matches | Log("FOX with context")

// Test 4: Max matches limit
"quick|fox|line" | Grep(File: "grep-test.txt" CaseInsensitive: true MaxMatches: 3) = limited-matches
limited-matches | Log("Limited to 3 matches")

// Test 5: Invert match (lines NOT containing pattern)
"fox|FOX" | Grep(File: "grep-test.txt" InvertMatch: true) = inverted-matches
inverted-matches | Log("Lines without fox/FOX")

// Clean up test file
// "grep-test.txt" | FS.Remove
