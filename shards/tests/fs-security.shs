@mesh(root)

@wire(test-fs-security {
  Msg("Testing FS security features...")

  // Create test content
  "This is a test file for security features" = test-content

  // Test 1: FS.Read with MaxSize
  "test-maxsize.txt" | FS.Write(test-content Overwrite: true)

  // Should succeed - file is small
  "test-maxsize.txt" | FS.Read(MaxSize: 1000)
  Assert.Is(test-content true)
  Log("MaxSize test passed - small file")

  // Should fail - file exceeds limit
  Maybe({
    "test-maxsize.txt" | FS.Read(MaxSize: 10)
    Assert.Is(none true) // Should not reach here
  } {
    Msg("MaxSize test passed - rejected large file")
  } Silent: true)

  // Test 2: FS.Read chunked reading
  "Chunk1Chunk2Chunk3" = chunked-content
  "test-chunked.txt" | FS.Write(chunked-content Overwrite: true)

  [] >= chunks
  "test-chunked.txt" | Repeat({
    FS.Read(ChunkSize: 6)
    | When({Count | Is(0)} Return)
    >> chunks
  })

  chunks | Count | Assert.Is(3 true)
  chunks.0 | Assert.Is("Chunk1" true)
  chunks.1 | Assert.Is("Chunk2" true)
  chunks.2 | Assert.Is("Chunk3" true)
  Log("Chunked reading test passed")

  // Test 3: BasePath restriction
  // Get absolute path of current directory
  "." | FS.Absolute = base-path

  // Create absolute path for test file within base
  [base-path "test-basepath.txt"] | FS.Join = test-base-file

  // Should succeed - within base path
  test-base-file
  | FS.Write("Test BasePath" Overwrite: true BasePath: base-path)
  | FS.Read(BasePath: base-path)
  | Assert.Is("Test BasePath" true)
  Log("BasePath test passed - allowed path")

  // Test 4: BasePath prevents path traversal
  Maybe({
    "../test-traversal.txt"
    | FS.Write("Should fail" Overwrite: true BasePath: base-path)
    Assert.Is(none true) // Should not reach here
  } {
    Log("BasePath traversal test passed - blocked traversal")
  })

  // Test 5: FS.Copy with BasePath security
  "test-copy-src.txt" | FS.Write("Copy test" Overwrite: true)
  "test-copy-src.txt"
  | FS.Copy("test-copy-dst.txt" BasePath: base-path)

  "test-copy-dst.txt" | FS.Read | Assert.Is("Copy test" true)
  Log("FS.Copy security test passed")

  // Test 6: FS.Remove with BasePath security
  "test-remove.txt" | FS.Write("Remove test" Overwrite: true)
  "test-remove.txt" | FS.Remove(BasePath: base-path)
  | Assert.Is(true true)
  Log("FS.Remove security test passed")

  // Test 7: FS.CreateDirectories with BasePath security
  "test-dir" | FS.CreateDirectories(BasePath: base-path)
  "test-dir" | FS.IsDirectory | Assert.Is(true true)
  Log("FS.CreateDirectories security test passed")

  // Test 8: FS.Rename with BasePath security
  "test-rename-old.txt" | FS.Write("Rename test" Overwrite: true)
  "test-rename-old.txt"
  | FS.Rename("test-rename-new.txt" BasePath: base-path)

  "test-rename-new.txt" | FS.IsFile | Assert.Is(true true)
  Log("FS.Rename security test passed")

  // Cleanup
  "test-maxsize.txt" | FS.Remove
  "test-chunked.txt" | FS.Remove
  "test-basepath.txt" | FS.Remove
  "test-copy-dst.txt" | FS.Remove
  "test-rename-new.txt" | FS.Remove
  "test-dir" | FS.RemoveAll

  Msg("All FS security tests passed!")
})

@schedule(root test-fs-security)
@run(root) | Assert.Is(true)
