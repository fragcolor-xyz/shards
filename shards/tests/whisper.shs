; Test: Audio transcription via mistral.rs
; Currently disabled: no small audio-capable model available for testing.
; Requires a multimodal LLM with audio encoder (e.g. Gemma 4 E2B/E4B).
; See llm-audio.shs for the working test with Gemma 4 E2B.

@mesh(main)

@wire(whisper-test {
  Msg("whisper.shs: skipped — no suitable small audio model available")
})

@schedule(main whisper-test)
@run(main) | Assert.Is(true)
