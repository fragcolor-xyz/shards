; Test: Whisper audio transcription (llama.cpp C++ module)
; Requires a whisper GGUF model — not available in CI.
; To run locally: download ggml-tiny.bin from huggingface.co/ggerganov/whisper.cpp

@mesh(main)

@wire(whisper-test {
  Msg("whisper.shs: skipped — requires whisper model download")
})

@schedule(main whisper-test)
@run(main) | Assert.Is(true)
