
@template(say [what] {
  what >= hello
  " World!" | AppendTo(hello)
  what | Log
  hello | Log
})

@define(one 1)

@macro(macro1 [v] {
  v >= hello
  " World!" | AppendTo(hello)
  [[{const: {str: hello}}]] | ToJson
})

@macro(my-macro [n] {
  Sequence(pipelines)
  Repeat({
    {
      sh: {
        name: "Msg"
        params: [{str: "Hello"}]
      }
    } >> pipelines
  } Times: n)
  [pipelines] | ToJson | Log
})

@define(to-j-from-j {ToJson | ToHex})

@include("defs.shs") // if macro

@macro(for [from to code] {
  Sequence(pipelines)
  ForRange(from to {
    = idx
    {
      "const": {
        "num": {
          "int": idx
        }
      }
    } >> pipelines
    {
      sh: {
        name: "_SubFlow"
        params: [(@ast(code) | FromJson)]
      }
    } >> pipelines
  })
  [pipelines] | ToJson
})
