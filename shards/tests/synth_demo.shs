@schedule(main demo-noise-white)
@run(main)

; Pink noise
@wire(demo-noise-pink {
  Msg("Playing pink noise (warmer, natural)...")
  Audio.Device
  Audio.Channel(Shards: {
    none | Audio.Noise(Type: NoiseType::Pink Amplitude: 0.2)
  })
  Pause(1.5)
})

@schedule(main demo-noise-pink)
@run(main)

; Brown noise
@wire(demo-noise-brown {
  Msg("Playing brown noise (deep rumble)...")
  Audio.Device
  Audio.Channel(Shards: {
    none | Audio.Noise(Type: NoiseType::Brown Amplitude: 0.25)
