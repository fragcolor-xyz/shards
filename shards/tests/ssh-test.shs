; SSH Module Test
; This test file demonstrates SSH.Connect, SSH.Execute, SSH.SendInput, and SSH.Disconnect

; Note: Update these with your SSH credentials before running
"localhost" = host
"your-username" = user
"~/.ssh/id_rsa" = key-path

; Connect to SSH server
SSH.Connect(Host: host User: user KeyPath: key-path) >= ssh-session

; Execute a simple command
"echo 'Hello from SSH!'" | SSH.Execute(Session: ssh-session) >= result
result | Log("First command result")

; Check command completed
result:status | Assert.Is("completed")

; Test persistent state - directory changes persist
"cd /tmp" | SSH.Execute(Session: ssh-session)
"pwd" | SSH.Execute(Session: ssh-session) >= pwd-result
pwd-result:output | Log("Current directory")
pwd-result:output | ExpectString | Assert.Contains("/tmp")

; Test environment variable persistence
"export TEST_VAR=hello" | SSH.Execute(Session: ssh-session)
"echo $TEST_VAR" | SSH.Execute(Session: ssh-session) >= env-result
env-result:output | Log("Environment variable")
env-result:output | ExpectString | Assert.Contains("hello")

; Test interactive command detection (python REPL)
; Commented out - uncomment to test interactive functionality
; "python3" | SSH.Execute(Session: ssh-session) >= interactive-result
; interactive-result:status | Assert.Is("requires_interaction")
;
; ; Send input to interactive command
; "print('Interactive works!')" | SSH.SendInput(Session: ssh-session) >= input-result
; input-result:output | Log("Interactive output")
;
; ; Exit interactive session
; "exit()" | SSH.SendInput(Session: ssh-session)

; Disconnect
ssh-session | SSH.Disconnect

"SSH tests passed!" | Log
