; Test: Gemma 4 E2B via mistral.rs (gated model - requires HF_TOKEN)
; Set HF_TOKEN env var or run `huggingface-cli login` first
; Skip this test in CI unless HF_TOKEN is configured

@mesh(main)

@wire(gemma4-test {
  "google/gemma-4-E2B-it"
  AI.Model(ISQ: ISQBits::Four) = model
  Log("Gemma 4 E2B loaded")

  model | AI.Chat = chat

  "What is the capital of Japan? Answer in one word." | AI.AddText(Chat: chat)

  chat | AI.Generate(Temperature: 0.1 MaxTokens: 32) | Log("Response")
})

@schedule(main gemma4-test)
@run(main) | Assert.Is(true)
