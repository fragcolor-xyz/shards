; Script to demonstrate error handling in Shards

; Maybe for handling potential errors
; First example - successful case
Maybe({
  "42" | FromJson | Log("Successfully parsed number")
  "Reached after successful parsing" | Log
} {
  "Error in first example" | Log("Error handler")
})

; Second example - error case
Maybe({
  "not a number" | FromJson | Log("This won't be reached")
  "This won't be reached either" | Log
} {
  "Error occurred in second example" | Log("Error handler")
})

; Another common use case - HTTP requests
Maybe({
  ; This is a simulation since we can't make real HTTP requests here
  "Simulating successful HTTP response" | Log("HTTP Request")
  "{\"status\": \"success\", \"data\": [1, 2, 3]}" | FromJson = response
  response | Take("data") | Log("Response data")
} {
  "Failed to complete HTTP request or parse response" | Log("HTTP Error")
})

; Nested Maybe blocks
Maybe({
  ; Outer try block
  "Outer try block" | Log
  Maybe({
    ; Inner try block
    "Inner try block" | Log
    "[1, 2, 3]" | FromJson | Log("Inner success")
  } {
    ; Inner catch block
    "Inner error handler" | Log
  })
  "After inner Maybe" | Log
} {
  ; Outer catch block
  "Outer error handler" | Log
})

; Maybe with invalid operations
Maybe({
  ; This will cause an error - accessing out of bounds index
  "not valid json" | FromJson | Log("Won't reach this")
} {
  "Caught index out of bounds error" | Log("Error handling")
})

; Return examples
{examples: {
  basic_maybe: "Maybe({try-block} {catch-block})",
  usage_scenarios: ["Parsing JSON", "HTTP requests", "File operations", "Index out of bounds"]
}}