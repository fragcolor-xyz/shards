// Script to demonstrate templates in Shards

// Define a simple template for doubling a value
@template(double-value [value] {
  value | Mul(2)
})

// Call the template with value 5
@double-value(5) | Log("Doubled result")

// Define a template with multiple parameters
@template(add-values [a b] {
  a | Add(b) 
})

// Call the multi-parameter template
@add-values(10 20) | Log("Addition result")

// Template for string formatting
@template(greet [name] {
  ["Hello, " name "!"] | String.Format
})

// Call the greeting template
@greet("Alice") | Log("Greeting")

// Return example templates
{examples: {
  define: "@template(name [params] { code })",
  call: "@template-name(args)"
}}