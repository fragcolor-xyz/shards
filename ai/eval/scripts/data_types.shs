// Script to demonstrate data types and sequences in Shards

// Basic types
42 = integer
3.14 = float
"Hello" = string
true = boolean
none = null_value
0x1A3F = hex_value

// Float vectors
@f2(1.0 2.0) = vec2
@f3(1.0 2.0 3.0) = vec3
@f4(1.0 2.0 3.0 4.0) = vec4

// Int vectors
@i2(1 2) = ivec2
@i3(1 2 3) = ivec3
@i4(1 2 3 4) = ivec4

// Log values to verify
integer | Log("Integer")
float | Log("Float")
string | Log("String")
boolean | Log("Boolean")
// null_value | Log("Null") ; Commented out as 'none' can't be logged directly
hex_value | Log("Hex")

vec2 | Log("Vec2")
vec3 | Log("Vec3")
vec4 | Log("Vec4")
ivec2 | Log("IVec2")
ivec3 | Log("IVec3")
ivec4 | Log("IVec4")

// Sequences
[1 2 3 4 5] >= numbers
["a" "b" "c"] >= strings
[true false true] >= booleans
[1.0 @f2(2.0 3.0) "mixed"] >= mixed_seq

// Sequence operations
numbers | Take(2) | Log("Element at index 2")
numbers | RTake(0) | Log("Last element")
numbers | Slice(1 3) | Log("Slice from 1 to 3")
numbers | Take([0 2 4]) | Log("Selected indices")

// Modify sequence
6 >> numbers
numbers | Log("After append")
Erase(2 numbers)
numbers | Log("After removing index 2")

// Tables
{name: "Alice" age: 30 city: "NY"} >= person
person:name | Log("Table access :key")
person | Take("age") | Log("Table access Take")

// Modify table
"Bob" | Update(person "name")
person | Log("After name update")
Erase("city" person)
person | Log("After removing city")

// Return a summary of the data types
{examples: {
  primitives: {int: integer, float: float, str: string, bool: boolean, null: null_value, hex: hex_value},
  vectors: {f2: vec2, f3: vec3, f4: vec4, i2: ivec2, i3: ivec3, i4: ivec4},
  sequences: {nums: numbers, strs: strings, mixed: mixed_seq},
  table: person
}}