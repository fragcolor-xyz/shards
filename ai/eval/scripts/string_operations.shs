// Script to demonstrate string operations in Shards

// Basic string assignment
"Hello" = greeting
"World" = subject

// String.Join for combining string sequences
[greeting subject] | String.Join = joined_no_space
joined_no_space | Log("Joined without space")

[greeting " " subject] | String.Join = joined_with_space
joined_with_space | Log("Joined with space")

["a" "b" "c" "d"] | String.Join = alphabet
alphabet | Log("Joined alphabet")

// String.Format for mixing strings with other types
["Number: " 42] | String.Format = num_str
num_str | Log("Formatted number")

["Vector: " @f3(1.0 2.0 3.0)] | String.Format = vec_str
vec_str | Log("Formatted vector")

// Mixing variables in String.Format
30 = age
[greeting "! I am " age " years old."] | String.Format = message
message | Log("Full message")

// Common pattern for authorization headers
"Bearer " = prefix
"token123" = token
[prefix token] | String.Join = auth_header
auth_header | Log("Auth header")

// Return the string operation examples
{examples: {
  join_example: joined_with_space,
  format_example: message,
  auth_example: auth_header
}}