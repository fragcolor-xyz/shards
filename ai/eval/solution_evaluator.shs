// Example usage
@wire(example-evaluation {
  // Sample solution for basic variable assignment
  "
  // Assign float value to mutable variable x
  2.5 >= x
  
  // Log the value
  x | Log(\"Value of x\")
  " = sample-solution
  
  // Evaluate the solution
  sample-solution | Set(solution-code)
  "basic_variable_assignment" | Set(problem-id)
  
  // Run evaluation
  Do(evaluate-solution)
})

