// Shards Evaluation Framework
// This script evaluates LLM-generated Shards code for correctness and understanding

// Define helper templates
@template(has-pattern [code pattern] {
  code | Regex.Search(Regex: pattern) | Not | IsEmpty
})

@template(count-pattern [code pattern] {
  code | Regex.Search(Regex: pattern) | Size
})

@template(extract-pattern [code pattern] {
  code | Regex.Match(Regex: pattern)
})

// Main evaluation function
@wire(evaluate-solution {
  // Parameters to be provided
  "" = solution-code     // The code to evaluate
  "" = problem-id        // Which problem we're evaluating
  {} = criteria          // Specific criteria for this problem
  
  // Initialize score
  0 >= total-score
  0 >= max-score
  [] >= feedback
  
  // Run generic syntax checks for all problems
  @check-basic-syntax(solution-code) = syntax-result
  syntax-result:score | Add(total-score) > total-score
  syntax-result:max | Add(max-score) > max-score
  syntax-result:feedback >> feedback
  
  // Run problem-specific checks based on problem-id
  problem-id | Match([
    "basic_variable_assignment" {
      @check-basic-variable-assignment(solution-code) = check-result
    }
    "immutable_vs_mutable" {
      @check-immutable-vs-mutable(solution-code) = check-result
    }
    "sequence_operations" {
      @check-sequence-operations(solution-code) = check-result
    }
    "string_formation" {
      @check-string-formation(solution-code) = check-result
    }
    "control_flow_challenge" {
      @check-control-flow(solution-code) = check-result
    }
    "table_manipulation" {
      @check-table-manipulation(solution-code) = check-result
    }
    "error_handling" {
      @check-error-handling(solution-code) = check-result
    }
    "operation_grouping" {
      @check-operation-grouping(solution-code) = check-result
    }
    "template_usage" {
      @check-template-usage(solution-code) = check-result
    }
    "wire_state" {
      @check-wire-state(solution-code) = check-result
    }
    "advanced_challenge" {
      @check-advanced-challenge(solution-code) = check-result
    }
    "equivalence_challenge" {
      @check-equivalence-challenge(solution-code) = check-result
    }
    none {
      {score: 0 max: 0 feedback: ["Unknown problem ID"]} = check-result
    }
  ])
  
  // Add problem-specific checks to total score
  check-result:score | Add(total-score) > total-score
  check-result:max | Add(max-score) > max-score
  check-result:feedback | ForEach({
    Push(feedback)
  })
  
  // Calculate percentage score
  total-score | ToFloat | Div((max-score | ToFloat)) | Mul(100.0) >= percentage
  
  // Create result table
  {score: total-score max: max-score percentage: percentage feedback: feedback}
})

// Template for basic syntax checks applicable to all problems
@template(check-basic-syntax [code] {
  0 >= score
  0 >= criteria-count
  [] >= feedback
  
  // Check for semicolons at end of lines (incorrect C-style syntax)
  @has-pattern(code "[^;];\\s*$") = has-semicolons
  has-semicolons | If({
    "Found semicolons at line endings, which is incorrect in Shards" >> feedback
  } {})
  
  // Check for proper pipe usage
  @has-pattern(code "\\|\\s+\\w+") = has-pipes
  has-pipes | If({
    criteria-count | Add(1) > criteria-count
    score | Add(1) > score
    "✓ Correctly uses pipe operator for data flow" >> feedback
  } {
    criteria-count | Add(1) > criteria-count
    "✗ Missing or incorrect pipe operator usage" >> feedback
  })
  
  // Check for proper comments
  @has-pattern(code ";.*") = has-comments
  has-comments | If({
    criteria-count | Add(1) > criteria-count
    score | Add(1) > score
    "✓ Includes proper comments with semicolon" >> feedback
  } {
    criteria-count | Add(1) > criteria-count
    "✗ Missing comments or incorrect comment syntax" >> feedback
  })
  
  // Check for capitalized shard names
  @has-pattern(code "\\|\\s+[A-Z][\\w\\.]*") = has-capitalized-shards
  has-capitalized-shards | If({
    criteria-count | Add(1) > criteria-count
    score | Add(1) > score
    "✓ Correctly uses capitalized Shard names" >> feedback
  } {
    criteria-count | Add(1) > criteria-count
    "✗ Shard names should be capitalized" >> feedback
  })
  
  {score: score max: criteria-count feedback: feedback}
})

// Template for checking basic variable assignment
@template(check-basic-variable-assignment [code] {
  0 >= score
  5 = max-score  // Total criteria for this problem
  [] >= feedback
  
  // Check for float value
  @has-pattern(code "[0-9]+\\.[0-9]*\\s+>=\\s+x") = has-float-assignment
  has-float-assignment | If({
    score | Add(1) > score
    "✓ Correctly assigns a float value to variable x" >> feedback
  } {
    "✗ Missing or incorrect float assignment to variable x" >> feedback
  })
  
  // Check for mutable assignment
  @has-pattern(code "[0-9\\.]+\\s+>=\\s+x") = has-mutable
  has-mutable | If({
    score | Add(1) > score
    "✓ Correctly uses >= for mutable assignment" >> feedback
  } {
    "✗ Should use >= for mutable assignment" >> feedback
  })
  
  // Check for logging
  @has-pattern(code "x\\s+\\|\\s+Log") = has-logging
  has-logging | If({
    score | Add(1) > score
    "✓ Correctly logs the variable" >> feedback
  } {
    "✗ Missing or incorrect logging of variable x" >> feedback
  })
  
  // Check for correct data flow
  @has-pattern(code "x\\s+\\|\\s+\\w+") = has-flow
  has-flow | If({
    score | Add(1) > score
    "✓ Correctly uses data flow with the pipe operator" >> feedback
  } {
    "✗ Incorrect or missing data flow with pipe operator" >> feedback
  })
  
  // Check for proper variable naming (lowercase)
  @has-pattern(code ">=\\s+[a-z][-a-z0-9]*") = has-proper-naming
  has-proper-naming | If({
    score | Add(1) > score
    "✓ Uses correct variable naming convention" >> feedback
  } {
    "✗ Variable names should be lowercase with optional hyphens" >> feedback
  })
  
  {score: score max: max-score feedback: feedback}
})

// Template for checking immutable vs mutable variables
@template(check-immutable-vs-mutable [code] {
  0 >= score
  5 = max-score  // Total criteria for this problem
  [] >= feedback
  
  // Check for immutable assignment with =
  @has-pattern(code "[0-9]+\\s+=\\s+count") = has-immutable
  has-immutable | If({
    score | Add(1) > score
    "✓ Correctly uses = for immutable assignment" >> feedback
  } {
    "✗ Missing or incorrect immutable assignment with =" >> feedback
  })
  
  // Check for mutable assignment with >=
  @has-pattern(code "[0-9]+\\s+>=\\s+total") = has-mutable
  has-mutable | If({
    score | Add(1) > score
    "✓ Correctly uses >= for mutable assignment" >> feedback
  } {
    "✗ Missing or incorrect mutable assignment with >=" >> feedback
  })
  
  // Check for attempt to update immutable variable (should show understanding this won't work)
  @has-pattern(code "count\\s+\\|\\s+Add\\([0-9]+\\)") = attempts-immutable-update
  attempts-immutable-update | If({
    score | Add(1) > score
    "✓ Demonstrates attempt to update immutable variable" >> feedback
  } {
    "✗ Should demonstrate an attempt to update the immutable variable" >> feedback
  })
  
  // Check for updating mutable variable
  @has-pattern(code "total\\s+\\|\\s+Add\\([0-9]+\\)\\s+>\\s+total") = updates-mutable
  updates-mutable | If({
    score | Add(1) > score
    "✓ Correctly updates mutable variable with >" >> feedback
  } {
    "✗ Missing or incorrect update of mutable variable" >> feedback
  })
  
  // Check for explanatory comments
  @has-pattern(code ";.*immutable.*|;.*mutable") = has-explanations
  has-explanations | If({
    score | Add(1) > score
    "✓ Includes explanatory comments about variable mutability" >> feedback
  } {
    "✗ Should include comments explaining immutable vs mutable behavior" >> feedback
  })
  
  {score: score max: max-score feedback: feedback}
})

// Template for checking sequence operations
@template(check-sequence-operations [code] {
  0 >= score
  6 = max-score  // Total criteria for this problem
  [] >= feedback
  
  // Check for sequence creation
  @has-pattern(code "\\[[0-9, ]+\\]\\s+>=\\s+numbers") = has-sequence
  has-sequence | If({
    score | Add(1) > score
    "✓ Correctly creates a mutable sequence" >> feedback
  } {
    "✗ Missing or incorrect sequence creation" >> feedback
  })
  
  // Check for append operation
  @has-pattern(code "[0-9]+\\s+>>\\s+numbers|Push\\(numbers\\)") = has-append
  has-append | If({
    score | Add(1) > score
    "✓ Correctly appends value to sequence" >> feedback
  } {
    "✗ Missing or incorrect sequence append operation" >> feedback
  })
  
  // Check for element access
  @has-pattern(code "numbers\\s+\\|\\s+Take\\([0-9]+\\)") = has-element-access
  has-element-access | If({
    score | Add(1) > score
    "✓ Correctly accesses sequence element by index" >> feedback
  } {
    "✗ Missing or incorrect sequence element access" >> feedback
  })
  
  // Check for last element access
  @has-pattern(code "numbers\\s+\\|\\s+RTake\\([0-9]+\\)") = has-last-element
  has-last-element | If({
    score | Add(1) > score
    "✓ Correctly accesses last element with RTake" >> feedback
  } {
    "✗ Missing or incorrect access of last element" >> feedback
  })
  
  // Check for element removal
  @has-pattern(code "Erase\\([0-9]+\\s+numbers\\)") = has-remove
  has-remove | If({
    score | Add(1) > score
    "✓ Correctly removes element from sequence" >> feedback
  } {
    "✗ Missing or incorrect element removal" >> feedback
  })
  
  // Check for logging the sequence
  @has-pattern(code "numbers\\s+\\|\\s+Log") = has-logging
  has-logging | If({
    score | Add(1) > score
    "✓ Correctly logs the sequence" >> feedback
  } {
    "✗ Missing or incorrect logging of sequence" >> feedback
  })
  
  {score: score max: max-score feedback: feedback}
})

// Placeholder for other problem checks
// In a complete implementation, we would include detailed templates for each problem
@template(check-string-formation [code] {
  0 >= score
  4 = max-score
  [] >= feedback
  
  // Check for String.Join usage
  @has-pattern(code "\\|\\s+String\\.Join") = has-join
  has-join | If({
    score | Add(1) > score
    "✓ Correctly uses String.Join" >> feedback
  } {
    "✗ Missing or incorrect String.Join usage" >> feedback
  })
  
  // Check for String.Format usage
  @has-pattern(code "\\|\\s+String\\.Format") = has-format
  has-format | If({
    score | Add(1) > score
    "✓ Correctly uses String.Format" >> feedback
  } {
    "✗ Missing or incorrect String.Format usage" >> feedback
  })
  
  // Check for mixed types in Format
  @has-pattern(code "\\[.*[0-9]+.*\\]\\s+\\|\\s+String\\.Format") = has-mixed-types
  has-mixed-types | If({
    score | Add(1) > score
    "✓ Correctly uses String.Format with mixed types" >> feedback
  } {
    "✗ String.Format should be used with mixed types" >> feedback
  })
  
  // Check for explanation
  @has-pattern(code ";.*String\\.Join.*String\\.Format") = has-explanation
  has-explanation | If({
    score | Add(1) > score
    "✓ Includes explanation of String.Join vs String.Format" >> feedback
  } {
    "✗ Missing explanation of when to use Join vs Format" >> feedback
  })
  
  {score: score max: max-score feedback: feedback}
})

